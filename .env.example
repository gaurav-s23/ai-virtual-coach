# Backend (FastAPI / Gemini)
# This project consistently uses GOOGLE_API_KEY. If GEMINI_API_KEY is also set, it will be ignored.
GOOGLE_API_KEY=

# Auth (JWT)
# Generate a strong random string and keep it secret.
JWT_SECRET_KEY=
# JWT signing algorithm (default HS256)
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (SlowAPI)
# Set to false in tests to avoid interference.
RATELIMIT_ENABLED=true

# Migrations
# Migrations should be applied manually (or via CI / docker-compose migration service).
RUN_MIGRATIONS_ON_STARTUP=false

# Chroma persistence directory inside backend container / host
CHROMA_DIR=./backend/.chroma

# Gemini embeddings model (override if needed)
# Recommended:
EMBEDDING_MODEL=text-embedding-04

# Postgres (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_virtual_coach

# Use Postgres in production; backend falls back to SQLite if omitted.
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_virtual_coach
DATABASE_URL=

# Frontend (Vite)
# Optional. If empty, frontend uses same-origin `/api` (recommended with Docker/Nginx).
VITE_API_URL=

# Admin User (Required)
# These must be set for the application to start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# LLM Configuration
# Optional: HuggingFace token for higher rate limits
HF_TOKEN=
# LLM timeout in seconds (default 12)
LLM_TIMEOUT_S=12
# LLM temperature (default 0.2)
LLM_TEMPERATURE=0.2
# LLM cache TTL in seconds (default 900)
LLM_CACHE_TTL_SECONDS=900

# Redis (Optional)
# Optional: Redis URL for distributed caching
REDIS_URL=

# HuggingFace Models
# Embedding model (default sentence-transformers/all-MiniLM-L6-v2)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HuggingFace cache directory
HF_HOME=/app/.hf_cache
# Transformers cache directory
TRANSFORMERS_CACHE=/app/.hf_cache
# Sentence transformers cache directory
SENTENCE_TRANSFORMERS_HOME=/app/.hf_cache

# RAG Worker Configuration
# Number of RAG workers (default 1)
RAG_WORKER_COUNT=1

