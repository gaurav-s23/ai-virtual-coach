# Backend (FastAPI / Gemini)
# This project consistently uses GOOGLE_API_KEY. If GEMINI_API_KEY is also set, it will be ignored.
GOOGLE_API_KEY=

# Auth (JWT)
# Generate a strong random string and keep it secret.
JWT_SECRET_KEY=
# JWT signing algorithm (default HS256)
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting (SlowAPI)
# Set to false in tests to avoid interference.
RATELIMIT_ENABLED=true

# Migrations
# Migrations should be applied manually (or via CI / docker-compose migration service).
RUN_MIGRATIONS_ON_STARTUP=false

# Chroma persistence directory inside backend container / host
CHROMA_DIR=./backend/.chroma

# Gemini embeddings model (override if needed)
# Recommended:
EMBEDDING_MODEL=text-embedding-04

# Postgres (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_virtual_coach

# Use Postgres in production; backend falls back to SQLite if omitted.
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_virtual_coach
DATABASE_URL=

# Frontend (Vite)
# Optional. If empty, frontend uses same-origin `/api` (recommended with Docker/Nginx).
VITE_API_URL=

